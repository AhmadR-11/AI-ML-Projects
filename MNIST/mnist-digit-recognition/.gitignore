# Virtual Environments
.mnist_env/
.venv/
venv/
env/
ENV/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# Data Files (Keep structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Large Data & Binary Files
*.csv
*.tsv
*.zip
*.tar
*.gz
*.parquet
*.npy
*.npz

# Model Checkpoints & Weights
*.h5
*.hdf5
*.keras
*.pth
*.pt
*.ckpt
*.pb
*.onnx
*.joblib
*.pkl
models/*
!models/.gitkeep

# Sensitive Credentials & Keys
kaggle.json
.env
.env.*
*.pem
*.key

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*-checkpoint.ipynb

# System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# Editor Configs
.vscode/
.idea/
*.swp
*.swo

# Log Files
*.log
logs/
