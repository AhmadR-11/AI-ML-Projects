# Virtual Environments
.mnist_env/
.venv/
venv/
env/
ENV/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# Data Files (Ignore large data files, keep folder structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
mnist-digit-recognition/data/raw/*
!mnist-digit-recognition/data/raw/.gitkeep
mnist-digit-recognition/data/processed/*
!mnist-digit-recognition/data/processed/.gitkeep

# Large Data & Binary Files
*.csv
*.tsv
*.zip
*.tar
*.gz
*.parquet
*.npy
*.npz

# Model Checkpoints & Weights
*.h5
*.hdf5
*.keras
*.pth
*.pt
*.ckpt
*.pb
*.onnx
*.joblib
*.pkl
models/*
!models/.gitkeep
mnist-digit-recognition/models/*
!mnist-digit-recognition/models/.gitkeep

# Sensitive Credentials & Keys
kaggle.json
.env
.env.*
*.pem
*.key

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*-checkpoint.ipynb

# System & Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# Editor & IDE Configs
.vscode/
.idea/
*.swp
*.swo

# Log Files
*.log
logs/
